<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ draws a launch splash from the theme: the two-brick icon on
         the night ground, so it hands straight over to the first frame. -->
    <style name="Theme.ClickClack" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/night_base</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/night_base</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/night_base</item>
    </style>
</resources>
