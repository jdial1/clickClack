      "depth": 2,
      "options": [
        "The first one",
        "The second",
        "The third",
        "A later one",
        "This one",
        "Still coming"
      ]
    },
    {
      "id": "fs9",
      "text": "Which small ritual of ours would you miss most?",
      "type": "REFLECT",
      "depth": 2
    },
    {
      "id": "fs10",
      "text": "What is the first thing you would tell someone about me?",
