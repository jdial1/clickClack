{
  "id": "know-me",
  "title": "Do you know me",
  "theme": "KNOW_ME",
  "blurb": "The basics, and whether you actually have them right.",
  "questions": [
    {
      "id": "km1",
      "text": "What do I complain about most, that I would deny complaining about?",
      "type": "GUESS_ME",
      "depth": 2
    },
    {
      "id": "km2",
      "text": "Which of these would ruin my day fastest?",
      "type": "PICK_ONE",
      "depth": 2,
      "options": [
        "Being late",
        "Being interrupted",
        "Being cold",
        "Being hungry"
      ]
    },
    {
      "id": "km3",
      "text": "In an argument I go:",
      "type": "THIS_OR_THAT",
      "depth": 2,
      "options": [
        "Quiet",
        "Loud"
      ]
    },
    {
      "id": "km4",
      "text": "Pick everything I would say I am good at.",
      "type": "MULTI_SELECT",
      "depth": 2,
      "options": [
        "Remembering things",
        "Staying calm",
        "Making plans",
        "Letting things go",
        "Saying sorry"
      ],
      "maxChoices": 3
    },
    {
      "id": "km5",
      "text": "Order these by how much I need them.",
      "type": "RANK",
      "depth": 2,
      "options": [
        "Time on my own",
        "Being told I did well",
        "Being left to do it my way",
        "Someone to talk it through with"
      ]
    },
    {
      "id": "km6",
      "text": "How well do I hide it when something is wrong?",
      "type": "SCALE",
      "depth": 2,
      "lowLabel": "You always know",
      "highLabel": "You never know"
    },
    {
      "id": "km7",
      "text": "What time do I actually want to go to bed?",
      "type": "DROPDOWN",
      "depth": 1,
      "options": [
        "Before nine",
        "Nine",
        "Ten",
        "Eleven",
        "Midnight",
        "One",
        "Later than that"
      ]
    },
    {
      "id": "km8",
      "text": "What is something I believe that you think is nonsense?",
      "type": "REFLECT",
      "depth": 3
    },
    {
      "id": "km9",
      "text": "What would I take if the house were on fire and the people were already out?",
      "type": "GUESS_ME",
      "depth": 2
    },
    {
      "id": "km10",
      "text": "Describe me to someone who has never met me, in one sentence.",
      "type": "REFLECT",
      "depth": 3
    }
  ]
}
