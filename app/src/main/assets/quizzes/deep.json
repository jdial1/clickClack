{
  "id": "deep",
  "title": "The real ones",
  "theme": "DEEP",
  "blurb": "Save these for an evening with nothing after it.",
  "questions": [
    {
      "id": "dp1",
      "text": "What did you need this week that you did not ask for?",
      "type": "REFLECT",
      "depth": 3
    },
    {
      "id": "dp2",
      "text": "What am I most afraid of, that I have never said out loud?",
      "type": "GUESS_ME",
      "depth": 3
    },
    {
      "id": "dp3",
      "text": "When I go quiet, what is usually going on?",
      "type": "PICK_ONE",
      "depth": 3,
      "options": [
        "I am working something out",
        "I am tired",
        "I am upset with you",
        "Nothing at all"
      ]
    },
    {
      "id": "dp4",
      "text": "Pick what you want more of from me.",
      "type": "MULTI_SELECT",
      "depth": 3,
      "options": [
        "Attention",
        "Space",
        "Practical help",
        "Being told",
        "Being asked"
      ],
      "maxChoices": 2
    },
    {
      "id": "dp5",
      "text": "Order these by what you need most right now.",
      "type": "RANK",
      "depth": 3,
      "options": [
        "To be listened to",
        "To be left alone",
        "To be helped",
        "To be told it is fine"
      ]
    },
    {
      "id": "dp6",
      "text": "How close have you felt to me this month?",
      "type": "SCALE",
      "depth": 3,
      "lowLabel": "Distant",
      "highLabel": "Very close"
    },
    {
      "id": "dp7",
      "text": "Us, generally:",
      "type": "THIS_OR_THAT",
      "depth": 3,
      "options": [
        "Say it straight away",
        "Wait until it is calm"
      ]
    },
    {
      "id": "dp8",
      "text": "Which part of the day do you most want me in?",
      "type": "DROPDOWN",
      "depth": 2,
      "options": [
        "First thing",
        "The commute",
        "Lunch",
        "The hour after work",
        "Dinner",
        "Last thing at night"
      ]
    },
    {
      "id": "dp9",
      "text": "What do you forgive me for over and over?",
      "type": "REFLECT",
      "depth": 3
    },
    {
      "id": "dp10",
      "text": "What compliment do you most want to hear, and never get?",
      "type": "GUESS_ME",
      "depth": 3
    },
    {
      "id": "dp11",
      "text": "Pick what you would want from me on a genuinely bad day.",
      "type": "MULTI_SELECT",
      "depth": 3,
      "options": [
        "Be left alone",
        "Be sat with",
        "Be fed",
        "Be told it will pass",
        "Be taken out of the house"
      ],
      "maxChoices": 2
    }
  ]
}
