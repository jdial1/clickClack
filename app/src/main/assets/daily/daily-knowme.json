      "depth": 2,
      "tags": [
        "friends",
        "family"
      ],
      "lowLabel": "Not at all",
      "highLabel": "More than I admit"
    },
    {
      "id": "dkm6",
      "text": "Pick the compliments that would actually land with me.",
      "type": "MULTI_SELECT",
      "depth": 1,
      "options": [
        "You are funny",
        "You are good at your job",
        "You look great",
        "You were right",
        "You handled that well"
      ],
      "maxChoices": 2,
      "tags": [
        "words"
      ]
    },
    {
      "id": "dkm7",
      "text": "Order these by how much I would miss them.",
      "type": "RANK",
      "depth": 2,
      "options": [
        "My friends",
        "My routine",
        "My hometown",
        "My own space"
      ],
      "tags": [
        "friends",
        "home"
      ]
    },
    {
      "id": "dkm8",
      "text": "What part of me do you think I am still working on?",
      "type": "GUESS_ME",
      "depth": 3,
      "tags": [
        "past"
      ]
    }
  ]
