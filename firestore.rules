rules_version = '2';

// Click Clack.
//
// The seal is enforced here, not in the app. The UI hiding your partner's
// answer would be a convention; this makes it unreadable.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }

    function couple(cid) {
      return get(/databases/$(database)/documents/couples/$(cid)).data;
    }
    function isMember(cid) {
      return signedIn() && me() in couple(cid).members;
    }
    // A couple with an endedAt is over. Nobody writes to it again.
    function isLive(cid) {
      return isMember(cid) && couple(cid).endedAt == null;
    }

    // Redeeming an invite has to land in *both* user documents at once --
    // otherwise the person who made the code is never told it was taken -- and
    // a user document is writable only by its owner, which is precisely the
    // write the joiner cannot make. So being paired is treated as a thing you
    // consent to in advance: you are only joinable while you are holding out a
    // live invite, and the write may do nothing but set the couple and consume
    // the code.
    //
    // It asks your document rather than the invite document, even though the
    // invite is the thing being redeemed. `inviteCode` and `inviteExpiresAt`
    // are on your document because *you* put them there -- nobody else may
    // write them -- so it is the same assertion one read cheaper.
    //
    // What this does not do is prove the joiner knows the code, which no rule
    // can: the couple document they point you at is created in the same
    // transaction, so a rule cannot read it. The window is what bounds it --
    // someone who knows your uid can join you only while you are holding a live
    // invite out, and only for the hour it lasts.
    function joining(uid) {
      return resource != null
        && 'inviteCode' in resource.data
        && resource.data.inviteCode is string
        && 'inviteExpiresAt' in resource.data
        && resource.data.inviteExpiresAt is timestamp
        && resource.data.inviteExpiresAt > request.time
        && (!('coupleId' in resource.data) || resource.data.coupleId == null)
        && request.resource.data.coupleId is string
        // Everything else about you is untouchable: not your name, not your
        // colour, not anything added later.
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['coupleId', 'inviteCode', 'inviteExpiresAt']);
    }

    match /users/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && uid == me();
      // Yours, or the one write another person may make to it: joining you.
      allow update: if signedIn() && (uid == me() || joining(uid));
      allow delete: if false;
    }

    // Pairing codes.
    //
    // `get` but never `list`. The code *is* the secret, so enumerating the
    // collection would hand over every outstanding invite. Anyone holding a
    // code may delete it, because redeeming one consumes it and the redeemer
    // is by definition not the person who made it.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;

      // The lifetime is bounded here, not just in the client. A code that
      // never expires is a code that leaks: it sits in a message thread and
      // still works months later. An hour is the window for "read this out to
      // the person next to you", and the two-hour ceiling stops a client
      // minting one that lasts a year.
      allow create: if signedIn()
        && request.resource.data.fromUid == me()
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(2, 'h');

      allow delete: if signedIn();
      allow update: if false;
    }

    match /couples/{cid} {
      allow get: if signedIn() && me() in resource.data.members;
      allow list: if false;

      // You may only create a couple you are in, and only of exactly two.
      allow create: if signedIn()
        && me() in request.resource.data.members
        && request.resource.data.members.size() == 2
        && request.resource.data.endedAt == null;

      // Members may update, but never rewrite who is in it. Ending the couple
      // lives here rather than on each user document precisely so that one
      // person can end it for both -- a user document is writable only by its
      // owner, which is what made unpairing one-sided.
      allow update: if isMember(cid)
        && request.resource.data.members == resource.data.members;
      allow delete: if false;

      match /days/{day} {
        allow read: if isMember(cid);
        allow create: if isLive(cid);

        // `revealed` is the seal, so a client must not be able to flip it
        // early and read the other answer. It may only become true once both
        // answer documents actually exist.
        allow update: if isLive(cid) && (
          request.resource.data.revealed == false ||
          (
            exists(/databases/$(database)/documents/couples/$(cid)/days/$(day)/answers/$(couple(cid).members[0])) &&
            exists(/databases/$(database)/documents/couples/$(cid)/days/$(day)/answers/$(couple(cid).members[1]))
          )
        );
        allow delete: if false;

        // The sealed part, and the reason answers are one document per person:
        // rules are per-document and cannot hide a field inside a shared one.
        match /answers/{uid} {
          allow read: if isMember(cid) && (
            uid == me() ||
            get(/databases/$(database)/documents/couples/$(cid)/days/$(day)).data.revealed == true
          );
          allow create: if isLive(cid) && uid == me();
          // No edits after submit. That is the point.
          allow update, delete: if false;
        }
      }

      // Decks, sealed exactly like days. A run is one document per person, so
      // the partner's is genuinely unreadable until both are in -- the same
      // reason answers are not two fields on one document.
      match /quizzes/{quizId} {
        allow read: if isMember(cid);
        allow create: if isLive(cid);
        allow update: if isLive(cid) && (
          request.resource.data.revealed == false ||
          (
            exists(/databases/$(database)/documents/couples/$(cid)/quizzes/$(quizId)/runs/$(couple(cid).members[0])) &&
            exists(/databases/$(database)/documents/couples/$(cid)/quizzes/$(quizId)/runs/$(couple(cid).members[1]))
          )
        );
        allow delete: if false;

        match /runs/{uid} {
          allow read: if isMember(cid) && (
            uid == me() ||
            get(/databases/$(database)/documents/couples/$(cid)/quizzes/$(quizId)).data.revealed == true
          );
          allow create: if isLive(cid) && uid == me();
          allow update, delete: if false;
        }
      }

      // Whole-instrument sittings, sealed exactly like decks. A run is one
      // document per person: forty love-language ratings on a shared document
      // could not be hidden from the other half of the couple, and the gap
      // between what one wants and what the other gives is only worth
      // measuring if neither could see the answer while giving theirs.
      match /instruments/{instrumentId} {
        allow read: if isMember(cid);
        allow create: if isLive(cid);
        allow update: if isLive(cid) && (
          request.resource.data.revealed == false ||
          (
            exists(/databases/$(database)/documents/couples/$(cid)/instruments/$(instrumentId)/runs/$(couple(cid).members[0])) &&
            exists(/databases/$(database)/documents/couples/$(cid)/instruments/$(instrumentId)/runs/$(couple(cid).members[1]))
          )
        );
        allow delete: if false;

        match /runs/{uid} {
          allow read: if isMember(cid) && (
            uid == me() ||
            get(/databases/$(database)/documents/couples/$(cid)/instruments/$(instrumentId)).data.revealed == true
          );
          allow create: if isLive(cid) && uid == me();
          // No edits. A retake is a new sitting, not a correction to an old one.
          allow update, delete: if false;
        }

        // A half-finished sitting, kept so that leaving does not throw it
        // away. Yours alone in both directions, and never readable by your
        // partner at any point -- a draft is unsealed answers, which is
        // precisely what the seal exists to hide, and unlike a run it has no
        // later moment at which it is safe to open. What crosses between the
        // two of you is the count on the parent document, which says how far
        // somebody has got and nothing about what they said.
        //
        // Writable rather than create-only, because rewriting it is what
        // resuming *is*. Deletable because sealing consumes it.
        match /drafts/{uid} {
          allow read, write: if isLive(cid) && uid == me();
        }
      }

      // Questions the two of you wrote. Not sealed: a question is not a
      // secret, and half the point is seeing what they asked before you
      // answer it. Only the text is protected -- either of you may stamp one
      // as asked, neither may rewrite what it says or who wrote it.
      match /wildcards/{id} {
        allow read: if isMember(cid);
        allow create: if isLive(cid) && request.resource.data.byUid == me();
        allow update: if isLive(cid)
          && request.resource.data.text == resource.data.text
          && request.resource.data.type == resource.data.type
          && request.resource.data.byUid == resource.data.byUid;
        allow delete: if false;
      }

      // One document per month, holding a map keyed by day. Both phones write
      // it and both write the same values, so there is nothing to protect
      // beyond membership -- and nothing a bad write could inflate, because
      // the totals are summed from what is read rather than incremented.
      match /knowing/{month} {
        allow read: if isMember(cid);
        allow create, update: if isLive(cid);
        allow delete: if false;
      }

      // Sealed sculptures. completedOn != null means finished, and a finished
      // plate must not gain bricks from a late listener.
      match /plates/{pid} {
        allow read: if isMember(cid);
        allow create: if isLive(cid);
        allow update: if isLive(cid) && resource.data.completedOn == null;
        allow delete: if false;
      }
    }
  }
}
